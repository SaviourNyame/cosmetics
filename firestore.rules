rules_version = '2';

// Security model for this project: almost every write in the app goes
// through a Next.js Server Action or Route Handler using the Firebase
// Admin SDK, which bypasses these rules entirely. That is intentional —
// business logic (permission checks, the request-acceptance transaction,
// activity logging) lives in server code, not in security rules. These
// rules exist as defense-in-depth for reads, and to make sure a
// compromised or buggy client can never write directly to Firestore.
//
// New collections/paths added by later modules should follow the same
// pattern: scope reads to the owner/admin, deny all client writes.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && role() == 'super_admin';
    }

    function isAdmin() {
      return isSignedIn() && (role() == 'admin' || role() == 'super_admin');
    }

    function isSupplier(supplierId) {
      return isSignedIn() && role() == 'supplier' && request.auth.token.supplierId == supplierId;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- Roles & Administrators ----
    match /roles/{roleId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow write: if false;
    }

    // ---- Suppliers ----
    match /suppliers/{supplierId} {
      allow read: if isAdmin() || isSupplier(supplierId);
      allow write: if false;

      match /documents/{docId} {
        allow read: if isAdmin() || isSupplier(supplierId);
        allow write: if false;
      }

      match /notes/{noteId} {
        allow read: if isAdmin(); // internal admin notes — never visible to the supplier
        allow write: if false;
      }

      // Banking details: authorised administrators only, never the supplier
      // themself via direct client read.
      match /private/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ---- Catalogue (public read for the storefront) ----
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;

      match /images/{imageId} {
        allow read: if true;
        allow write: if false;
      }

      match /variants/{variantId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /productSuppliers/{assignmentId} {
      allow read: if isAdmin() || isSupplier(resource.data.supplierId);
      allow write: if false;
    }

    // ---- Customers ----
    match /customers/{customerId} {
      allow read: if isAdmin() || isSelf(customerId);
      allow write: if false;

      match /addresses/{addressId} {
        allow read: if isAdmin() || isSelf(customerId);
        allow write: if false;
      }
    }

    // ---- Product requests (the matching engine) ----
    match /productRequests/{requestId} {
      allow read: if isAdmin()
        || isSelf(resource.data.customerId)
        || (isSignedIn() && role() == 'supplier'
            && exists(/databases/$(database)/documents/productRequests/$(requestId)/invitations/$(request.auth.token.supplierId)));
      allow write: if false;

      match /invitations/{supplierId} {
        allow read: if isAdmin() || isSupplier(supplierId);
        allow write: if false;
      }
    }

    // ---- Orders & deliveries ----
    match /orders/{orderId} {
      allow read: if isAdmin()
        || isSelf(resource.data.customerId)
        || isSupplier(resource.data.supplierId);
      allow write: if false;
    }

    match /deliveries/{deliveryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Payments, refunds, earnings, payouts (financial — admin/owner only) ----
    match /payments/{paymentId} {
      allow read: if isAdmin() || isSelf(resource.data.customerId) || isSupplier(resource.data.supplierId);
      allow write: if false;
    }

    match /refunds/{refundId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /supplierEarnings/{earningId} {
      allow read: if isAdmin() || isSupplier(resource.data.supplierId);
      allow write: if false;
    }

    match /supplierPayouts/{payoutId} {
      allow read: if isAdmin() || isSupplier(resource.data.supplierId);
      allow write: if false;
    }

    // ---- Notifications ----
    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (resource.data.targetType == 'supplier' && isSupplier(resource.data.targetId))
        || (resource.data.targetType == 'customer' && isSelf(resource.data.targetId));
      allow write: if false;
    }

    // ---- Activity logs & settings ----
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
